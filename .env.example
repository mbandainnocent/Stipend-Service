# PostgreSQL
POSTGRES_DB=stipenddb
POSTGRES_USER=stipend_app
POSTGRES_PASSWORD=password

# Application
APP_JWT_SECRET=change-this-to-a-long-secure-secret-key-at-least-32-bytes
APP_JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
APP_JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Optional mail settings for local dev
MAIL_USERNAME=no-reply@igirerwanda.org
MAIL_PASSWORD=your-mail-password

# Optional override: keep the default unless you need a custom local DB URL
# DB_URL=jdbc:postgresql://localhost:5432/stipenddb
